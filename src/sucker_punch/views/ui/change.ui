QPushButton#push_save, QPushButton#push_cancel { background: #f4f6fb; color: #000080;
    border: 1px solid #000080; border-radius: 4px; padding: 8px 18px; font-weight: bold; }
QPushButton#push_save:focus, QPushButton#push_cancel:focus { background: #e6ff8c; }
